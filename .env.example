# SpacePulse University Webmail & SMTP Configuration
# Set these variables if you want verification codes dispatched to real external email inboxes via SMTP.
# Leave blank to use the built-in University of Moratuwa Webmail Portal (webmail.uom.lk).

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply-spacepulse@uom.lk
